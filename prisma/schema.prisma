generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  UTILISATEUR
}

//
// UTILISATEURS
//

model Utilisateur {
  id              String          @id @default(uuid())
  courriel        String          @unique
  motDePasse      String
  role            Role            @default(UTILISATEUR)
  creeLe          DateTime        @default(now())
  majLe           DateTime        @updatedAt

  profil          Profil?
  panier          Panier?
  commandes       Commande[]
  ordonnances     Ordonnance[]
}

model Profil {
  id             String      @id @default(uuid())
  utilisateurId  String      @unique
  prenom         String?
  nom            String?
  telephone      String?
  adresse        String?

  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id])
}

//
// PRODUITS / CATALOGUE
//

model Produit {
  id              String        @id @default(uuid())
  nom             String
  description     String?
  prix            Float
  imageUrl        String?
  categorie       String?
  creeLe          DateTime      @default(now())

  itemsPanier     ItemPanier[]
  itemsCommande   ItemCommande[]
  itemsCirculaire ItemCirculaire[]
}

//
// PANIER
//

model Panier {
  id            String       @id @default(uuid())
  utilisateurId String       @unique
  creeLe        DateTime     @default(now())

  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id])
  items         ItemPanier[]
}

model ItemPanier {
  id        String   @id @default(uuid())
  panierId  String
  produitId String
  quantite  Int      @default(1)

  panier    Panier   @relation(fields: [panierId], references: [id])
  produit   Produit  @relation(fields: [produitId], references: [id])

  @@unique([panierId, produitId])
}

//
// COMMANDES / PAIEMENT
//

model Commande {
  id            String        @id @default(uuid())
  utilisateurId String
  total         Float
  statut        String        @default("en_attente")
  creeLe        DateTime      @default(now())

  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id])
  items         ItemCommande[]
}

model ItemCommande {
  id         String   @id @default(uuid())
  commandeId String
  produitId  String
  quantite   Int      @default(1)
  prix       Float

  commande   Commande @relation(fields: [commandeId], references: [id])
  produit    Produit  @relation(fields: [produitId], references: [id])
}

//
// ORDONNANCES
//

model Ordonnance {
  id            String   @id @default(uuid())
  utilisateurId String
  fichierUrl    String
  statut        String   @default("soumis")
  creeLe        DateTime @default(now())

  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

//
// RESSOURCES SANTÉ
//

model RessourceSante {
  id        String   @id @default(uuid())
  titre     String
  description   String
  url String
  creeLe    DateTime @default(now())
}

//
// CIRCULAIRE
//

model ItemCirculaire {
  id         String   @id @default(uuid())
  produitId  String
  rabais     Float
  valideJusquA DateTime

  produit    Produit  @relation(fields: [produitId], references: [id])
}

//
// CONTACT PHARMACIE
//

model InfoContact {
  id        String   @id @default(uuid())
  telephone String?
  courriel  String?
  adresse   String?
  heures    String?
}
